{
	"name": "effect-ts-detectors",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"check": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"detect:all": "bun run src/runner.ts"
	},
	"dependencies": {
		"@effect/schema": "^0.75.5",
		"effect": "^3.14.0",
		"typescript": "^5.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.13",
		"@types/bun": "^1.2.8",
		"bun-types": "^1.2.8",
		"@effect/vitest": "^0.18.0",
		"vitest": "^3.0.0"
	}
}
