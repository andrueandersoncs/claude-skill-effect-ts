{
	"name": "effect-ts-examples",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"check": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"detect": "bun run ../effect-ts-detectors/src/runner.ts",
		"detect:all": "bun run ../effect-ts-detectors/src/runner.ts",
		"detect:errors": "bun run ../effect-ts-detectors/src/runner.ts --no-potential",
		"detect:json": "bun run ../effect-ts-detectors/src/runner.ts --json",
		"detect:examples": "bun run ../effect-ts-detectors/src/runner.ts examples",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui"
	},
	"dependencies": {
		"@effect/schema": "^0.75.5",
		"effect": "^3.14.0",
		"effect-ts-detectors": "file:../effect-ts-detectors"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.13",
		"@effect/vitest": "^0.18.0",
		"@types/node": "^25.1.0",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	}
}
